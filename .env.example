# Postgres (Railway) — shared with Visavis_bot
DATABASE_URL="postgresql://user:password@host:5432/visavis?schema=public"

# Redis (Railway) — shared with Visavis_bot: rate limiting, cache, reminder queue
REDIS_URL="redis://default:password@host:6379"

# Auth — generate with `openssl rand -base64 48`. Rotate every 90 days;
# rotating invalidates all existing sessions (users are simply prompted to
# log in again via OTP — there is no refresh token to revoke separately yet).
JWT_SECRET="change-me-to-a-long-random-value"

# Telegram (used for OTP delivery + account linking with Visavis_bot)
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="salon_visavis_bot"

# Cloudinary (photos)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Public site URL (used for metadata, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL="https://visavis.example"
