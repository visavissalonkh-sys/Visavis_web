# Postgres (Railway) — shared with Visavis_bot
DATABASE_URL="postgresql://user:password@host:5432/visavis?schema=public"

# Redis (Railway) — shared with Visavis_bot: rate limiting, cache, reminder queue
REDIS_URL="redis://default:password@host:6379"

# Auth
JWT_SECRET="change-me-to-a-long-random-value"

# Telegram (used for OTP delivery + account linking with Visavis_bot)
TELEGRAM_BOT_TOKEN=""

# Cloudinary (photos)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Public site URL (used for metadata, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL="https://visavis.example"
